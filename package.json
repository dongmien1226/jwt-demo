{
  "name": "dasani-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup:local": "tsx scripts/setup.ts",
    "dev": "tsx scripts/dev.ts secure",
    "lab:jwk": "tsx scripts/dev.ts jwk lab",
    "lab:jku": "tsx scripts/dev.ts jku-redirect lab",
    "lab:kid": "tsx scripts/dev.ts kid-path-traversal lab",
    "lab:kid:fixed": "tsx scripts/dev.ts kid-path-traversal-fixed lab",
    "lab:secure": "tsx scripts/dev.ts secure lab",
    "build": "vite build --config apps/web/vite.config.ts && tsup apps/api/src/server.ts --format esm --out-dir dist --sourcemap",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:seed": "tsx scripts/database.ts seed",
    "keys:generate": "tsx scripts/keys.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
